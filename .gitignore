# Claude work notes (local only)
.claude-work/

# Claude Code local/session state (machine-specific paths, PID locks) —
# .claude/skills/ (project-scoped installed skills) IS meant to be committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Lighthouse
.lighthouseci/
# Local Chrome binary downloaded via @puppeteer/browsers for local Lighthouse runs
chrome/

# Local scratch directory (generators, smoke tests, profiles)
scratch/

# 3D authoring/reference sources stay local. Only optimized runtime exports
# (for example public/3d/scouting-scout/Scout.game.glb) belong in Git/builds.
art/source/mixamo/
art/source/new3d/
*.fbx
*.blend
*.blend1
*.obj
*.dae
*.3ds
*.max
*.mb
*.ma

