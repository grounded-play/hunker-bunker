server/data/*
!server/data/.gitkeep

# Claude work notes (local only)
.claude-work/

# Claude Code local/session state (machine-specific paths, PID locks) —
# .claude/skills/ (project-scoped installed skills) IS meant to be committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Lighthouse
.lighthouseci/
# Local Chrome binary downloaded via @puppeteer/browsers for local Lighthouse runs
chrome/

# Local scratch directory (generators, smoke tests, profiles)
scratch/
tmp/
temp/
screenshots/
test-artifacts/

# Root level temporary screenshots, visual smoke captures, and debug dumps
/*.png
/*.jpg
/*.jpeg
/*.webp
!index.html

# 2D/3D Authoring, reference sources, and graphic design masters stay local.
# Only optimized runtime exports (e.g. public/3d/runtime/ and public/economy/*.png) belong in Git/builds.
art/source/
art/raw/
art/scratch/
art/upscales/
