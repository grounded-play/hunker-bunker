.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Electron/Steam build outputs
dist_electron/
steam_build_output/
steam/app_build.generated.vdf
steam/soundtrack_app_build.generated.vdf
steam_appid.txt
electron/steam-config.json
dist_soundtrack/

# Local backend/dev stores
server/db_storage.json
server/db_storage.json.tmp

# Playwright e2e (Phase 13) output
playwright-report/
test-results/

# Local git worktrees (isolated workspaces)
.worktrees/
