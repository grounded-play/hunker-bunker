{
  "name": "hunker-bunker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "nodemon server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lighthouse:setup": "npx -y @puppeteer/browsers install chrome@stable",
    "lighthouse": "npm run build && CHROME_PATH=$(ls chrome/*/chrome-linux64/chrome 2>/dev/null | head -1) lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "phaser": "^3.80.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0"
  }
}
