{
  "name": "hunker-bunker",
  "version": "2.3.1-beta",
  "description": "A biomechanical survival roguelike set beneath the frozen surface of Cocytus IV.",
  "author": "Tuesday Cinema Club",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "server": "nodemon server/index.js",
    "server:start": "node server/index.js",
    "server:local": "node --env-file=.env.loco --watch server/index.js",
    "server:nonprod": "cross-env HB_DB_BACKEND=sqlite HB_DB_SQLITE_PATH=server/data/hunker-bunker-nonprod.sqlite HB_STEAM_STORE_ENABLED=1 HB_STEAM_MICROTXN_ENABLED=1 HB_STEAM_STORE_MOCK_PURCHASES=1 nodemon server/index.js",
    "build": "vite build && npm run audit:build-media",
    "audit:build-media": "node scripts/audit-build-media.js",
    "audit:retail-assets": "node scripts/audit-retail-assets.js",
    "audit:retail-assets:check": "node scripts/audit-retail-assets.js --check",
    "audit:retail-assets:package": "node scripts/audit-retail-assets.js --package",
    "audit:dependencies": "node scripts/audit-dependency-usage.js",
    "audit:world-seeds": "node scripts/world-seed-portfolio-report.js",
    "audit:world-seeds:sweep": "node scripts/world-seed-portfolio-report.js --sweep-only --sweep=5000",
    "audit:combat-encounters": "node scripts/combat-encounter-report.js",
    "audit:playtest-navigation": "node scripts/playtest-navigation-report.js",
    "audit:chroma-green": "node scripts/audit-chroma-green.js",
    "audit:chroma-green:check": "node scripts/audit-chroma-green.js --check",
    "presubmit": "npm run presubmit:generated",
    "presubmit:generated": "npm run steam:claims:check && npm run audio:plan-sfx:check && npm run audit:retail-assets:check && npm run steam:item-catalog:check && npm run audit:soundtrack && npm run audit:chroma-green:check",
    "audio:plan-sfx": "node scripts/generate-plan-sfx.js",
    "audio:plan-sfx:check": "node scripts/generate-plan-sfx.js --check",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:playthrough": "playwright test tests/e2e/automated-playthrough.spec.js",
    "coverage": "vitest run --coverage",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "steam:config": "node scripts/write-steam-config.js",
    "steam:dashboard-handoff": "node scripts/steam-dashboard-handoff.js",
    "steam:audit-backend": "node scripts/audit-steam-backend-env.js",
    "steam:audit-backend:strict": "node scripts/audit-steam-backend-env.js --strict",
    "steam:backend-volume": "node scripts/steam-backend-volume.js",
    "steam:smoke-leaderboards": "node scripts/smoke-steam-leaderboards.js",
    "steam:audit-inventory-assets": "node scripts/audit-steam-inventory-assets.js",
    "steam:item-catalog": "node scripts/build-steam-item-catalog.js",
    "steam:item-catalog:check": "node scripts/build-steam-item-catalog.js --check",
    "steam:claims": "node scripts/audit-steam-claims.js",
    "steam:claims:check": "node scripts/audit-steam-claims.js --check",
    "steam:audit-depot": "node scripts/audit-steam-depot.js",
    "steam:input-configs": "node scripts/build-steam-input-configs.js",
    "steam:prepare": "node scripts/steam-release.js",
    "steam:upload": "node scripts/steam-release.js --upload --soundtrack",
    "steam:upload-soundtrack": "node scripts/steam-release.js --upload --skip-build --soundtrack",
    "steam:drm-wrap": "node scripts/steam-drm-wrap.js",
    "electron:build": "npm run build && npm run steam:config && npm run steam:input-configs && electron-builder --dir --linux --win",
    "electron:dist": "npm run build && npm run steam:config && npm run steam:input-configs && electron-builder",
    "lighthouse:setup": "npx -y @puppeteer/browsers install chrome@stable",
    "lighthouse": "npm run build && CHROME_PATH=$(ls chrome/*/chrome-linux64/chrome 2>/dev/null | head -1) lhci autorun",
    "soundtrack:metadata": "node scripts/build-soundtrack-metadata.js",
    "audit:soundtrack": "node scripts/build-soundtrack-metadata.js --check && node scripts/package-soundtrack.js --check",
    "package-soundtrack": "node scripts/build-soundtrack-metadata.js && node scripts/package-soundtrack.js",
    "cinematics:stills": "node scripts/build-cinematic-still-videos.js",
    "trailer:capture": "playwright test --config=tests/e2e/trailer/trailer.playwright.config.js",
    "trailer:build": "node scripts/build-trailer.js"
  },
  "build": {
    "appId": "com.icecave.hunkerbunker",
    "productName": "Hunker Bunker",
    "executableName": "hunker-bunker",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist_electron"
    },
    "extraFiles": [
      {
        "from": "steam/steam_input_manifest.vdf",
        "to": "steam_input_manifest.vdf"
      },
      {
        "from": "steam/controller_configs",
        "to": "controller_configs"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/steamworks.js/**/*",
      "dist/**/*.mp4",
      "dist/**/*.webm",
      "dist/**/*.glb",
      "dist/**/*.mp3",
      "dist/**/*.wav",
      "dist/**/*.ogg"
    ],
    "linux": {
      "executableName": "hunker-bunker",
      "icon": "electron/icon.png",
      "target": "dir"
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": "dir"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "steamworks.js": "^0.4.0",
    "three": "^0.185.1"
  },
  "overrides": {
    "vite": "^8.1.5",
    "ws": "^8.21.1",
    "tmp": "^0.2.7",
    "uuid": "^14.0.1",
    "qs": "^6.15.3",
    "js-yaml": "^4.3.0",
    "launch-editor": "^2.14.1",
    "@puppeteer/browsers": "^3.2.1"
  }
}
