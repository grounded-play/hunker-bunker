"Action Manifest"
{
    // Bump major_revision whenever action sets are added/removed or bindings are
    // reworked enough that old user configs are unusable — Steam then force-updates
    // players onto the current official config. minor_revision is for additive
    // actions and localization tweaks. Read back via GetDeviceBindingRevision.
    "major_revision" "10"
    "minor_revision" "0"
    "configurations"
    {
        "controller_neptune"
        {
            "0" { "path" "controller_configs/controller_neptune.vdf" }
        }
        "controller_xboxone"
        {
            "0" { "path" "controller_configs/controller_xboxone.vdf" }
        }
        "controller_xbox360"
        {
            "0" { "path" "controller_configs/controller_xbox360.vdf" }
        }
        "controller_ps4"
        {
            "0" { "path" "controller_configs/controller_ps4.vdf" }
        }
        "controller_ps5"
        {
            "0" { "path" "controller_configs/controller_ps5.vdf" }
        }
        "controller_switch_pro"
        {
            "0" { "path" "controller_configs/controller_switch_pro.vdf" }
        }
        "controller_generic"
        {
            "0" { "path" "controller_configs/controller_generic.vdf" }
        }
    }
    "actions"
    {
        "menu"
        {
            "title" "#ActionSetMenu"
            "StickPadGyro"
            {
                "menu_pointer"
                {
                    "title" "#ActionMenuPointer"
                    "input_mode" "joystick_move"
                }
                "menu_pointer_mouse"
                {
                    "title" "#ActionMenuPointerMouse"
                    "input_mode" "absolute_mouse"
                }
            }
            "Button"
            {
                "menu_up" "#ActionMenuUp"
                "menu_down" "#ActionMenuDown"
                "menu_left" "#ActionMenuLeft"
                "menu_right" "#ActionMenuRight"
                "menu_confirm" "#ActionMenuConfirm"
                "menu_back" "#ActionMenuBack"
                "menu_tab_left" "#ActionMenuTabLeft"
                "menu_tab_right" "#ActionMenuTabRight"
                "pause" "#ActionPause"
            }
        }
        "gameplay"
        {
            "title" "#ActionSetGameplay"
            "StickPadGyro"
            {
                "move"
                {
                    "title" "#ActionMove"
                    "input_mode" "joystick_move"
                }
                "camera"
                {
                    "title" "#ActionCamera"
                    "input_mode" "joystick_move"
                }
                // Delta-style aim for Deck and PlayStation trackpads. The
                // right joystick remains on the direct camera action above.
                "camera_mouse"
                {
                    "title" "#ActionCameraMouse"
                    "input_mode" "absolute_mouse"
                }
            }
            "Button"
            {
                "fire" "#ActionFire"
                "interact" "#ActionInteract"
                "reload" "#ActionReload"
                "ability" "#ActionAbility"
                "dash" "#ActionDash"
                "scan" "#ActionScan"
                "sprint" "#ActionSprint"
                "pause" "#ActionPause"
                "toggle_map" "#ActionToggleMap"
            }
        }
        "archive"
        {
            "title" "#ActionSetArchive"
            "StickPadGyro"
            {
                "archive_focus"
                {
                    "title" "#ActionArchiveFocus"
                    "input_mode" "joystick_move"
                }
            }
            "Button"
            {
                "archive_confirm" "#ActionArchiveConfirm"
                "archive_inventory" "#ActionArchiveInventory"
                "archive_back" "#ActionArchiveBack"
                "archive_reveal" "#ActionArchiveReveal"
                "pause" "#ActionPause"
            }
        }
    }
    "localization"
    {
        "english"
        {
            "ActionSetMenu" "Menu"
            "ActionSetGameplay" "Gameplay"
            "ActionSetArchive" "Archive Simulation"
            "ActionMenuUp" "Up"
            "ActionMenuDown" "Down"
            "ActionMenuLeft" "Left"
            "ActionMenuRight" "Right"
            "ActionMenuConfirm" "Confirm"
            "ActionMenuBack" "Back"
            "ActionMenuTabLeft" "Previous Tab"
            "ActionMenuTabRight" "Next Tab"
            "ActionMenuPointer" "Right Stick Pointer"
            "ActionMenuPointerMouse" "Optional Trackpad Pointer"
            "ActionMove" "Move"
            "ActionCamera" "Aim"
            "ActionCameraMouse" "Aim Cursor"
            "ActionFire" "Fire"
            "ActionInteract" "Interact"
            "ActionReload" "Reload"
            "ActionAbility" "Smash"
            "ActionDash" "Dodge"
            "ActionScan" "Scan"
            "ActionSprint" "Sprint"
            "ActionPause" "Pause"
            "ActionToggleMap" "Tactical Map"
            "ActionArchiveFocus" "Move Focus"
            "ActionArchiveConfirm" "Inspect / Confirm"
            "ActionArchiveInventory" "Inventory"
            "ActionArchiveBack" "Back"
            "ActionArchiveReveal" "Reveal Hotspots"
        }
    }
}
