"DepotBuild"
{
    "DepotID" "4957042"
    // DepotPath is "." so the install root holds the exe, steam_input_manifest.vdf
    // and controller_configs/ — matching the Linux depot. See depot_build_content.vdf.
    "FileMapping"
    {
        "LocalPath" "win-unpacked/*"
        "DepotPath" "."
        "recursive" "1"
    }

    "FileExclusion" "steam_appid.txt"
    "FileExclusion" ".env"
    "FileExclusion" ".env.*"
    "FileExclusion" "db_storage.json"
    "FileExclusion" "db_storage.json.tmp"
    "FileExclusion" "*.pem"
    "FileExclusion" "*.p12"
    "FileExclusion" "*.pfx"
    "FileExclusion" "*.key"
}
