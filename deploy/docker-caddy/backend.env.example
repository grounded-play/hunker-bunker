NODE_ENV=production
PORT=3001

HB_STEAM_APPID=4957040
HB_STEAM_PUBLISHER_KEY=REPLACE_WITH_STEAMWORKS_PUBLISHER_KEY
HB_SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_48

# Electron requests generally omit Origin. Add only real HTTPS browser QA
# origins here, comma-separated. Never use "*" in production.
HB_ALLOWED_ORIGINS=https://steam.tuesdaycinema.club,https://tuesdaycinema.club,https://www.tuesdaycinema.club

HB_DB_STORAGE_PATH=/app/server/data/db_storage.sqlite
HB_STEAM_DROP_COOLDOWN_SECONDS=60

# Session-log drop box (in-game console `uploadlogs`). Captures from PC and
# Steam Deck land in one directory so a play session can be reviewed together.
# Keep this under /app/server/data so it lives on the persistent volume.
HB_SESSION_LOG_DIR=/app/server/data/session-logs
# Optional shared secret for uploads. Leave unset for a private/LAN host;
# set it on a publicly reachable backend so strangers cannot fill the disk.
HB_LOG_UPLOAD_TOKEN=
HB_STEAM_MICROTXN_ENABLED=0
HB_STEAM_STORE_ENABLED=0

# Fill this with the IDs created in Steamworks before strict production use.
HB_STEAM_LEADERBOARD_IDS=REPLACE_WITH_STEAMWORKS_LEADERBOARD_MAPPING
